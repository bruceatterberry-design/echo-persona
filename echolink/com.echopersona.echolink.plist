<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.echopersona.echolink</string>
  <key>ProgramArguments</key><array><string>/opt/homebrew/bin/uv</string><string>run</string><string>--frozen</string><string>python</string><string>-m</string><string>echolink</string></array>
  <key>WorkingDirectory</key><string>/Users/you/Echo</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/you/Echo/logs/com.echopersona.echolink.log</string>
  <key>StandardErrorPath</key><string>/Users/you/Echo/logs/com.echopersona.echolink.log</string>
</dict></plist>
